# 默认：所有文本文件统一使用 LF
* text=auto eol=lf

# 资源 / 数据
*.json text eol=lf
*.svg text eol=lf

# 配置 / 文档
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
LICENSE text eol=lf
licenses/** -whitespace
*.cpp text eol=lf
*.hpp text eol=lf
*.qml text eol=lf
*.cmake text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.wav binary

# Windows 批处理脚本保留 CRLF（cmd.exe 要求）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件，不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.icns binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.zip binary
*.tar binary
*.gz binary
