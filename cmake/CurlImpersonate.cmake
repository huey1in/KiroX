# Native library: no Python interpreter is needed by the application.
set(KIROX_CURL_ROOT "" CACHE PATH "An extracted libcurl-impersonate 2.2.3 SDK")
if(NOT KIROX_CURL_ROOT)
  if(WIN32 AND CMAKE_SYSTEM_PROCESSOR MATCHES "ARM64|aarch64")
    set(curl_platform arm64-win32)
    set(curl_hash 07f4a256e43a863b5d93f07b50fcb11fa1247f4983bf8537a39d573d2c7ff7d1)
  elseif(WIN32)
    set(curl_platform x86_64-win32)
    set(curl_hash 8236820afe03e5f08a5e8e34ad394bf9440061edd8e7cb9ccf5fa815b068d357)
  elseif(APPLE AND CMAKE_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
    set(curl_platform arm64-macos)
    set(curl_hash 16a73c8dfc55cb8c2354f93f43525529d0df6cbfc484fb7a4357b3891f9dbb6a)
  elseif(APPLE)
    set(curl_platform x86_64-macos)
    set(curl_hash 32634096e31e879d0a193f87e4a4083e2eb44b9b9318eb5b32f85f495104a049)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "x86_64|AMD64")
    set(curl_platform x86_64-linux-gnu)
    set(curl_hash d5eb746c109be4d945cc5fcbe8a5c4940471041be4901439d50111cc3c83359d)
  else()
    message(FATAL_ERROR "Set KIROX_CURL_ROOT to a native curl-impersonate SDK for this platform")
  endif()
  include(FetchContent)
  FetchContent_Declare(kirox_curl
    URL "https://github.com/lexiforest/curl-impersonate/releases/download/v2.2.3/libcurl-impersonate-v2.2.3.${curl_platform}.tar.gz"
    URL_HASH "SHA256=${curl_hash}" DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
  FetchContent_MakeAvailable(kirox_curl)
  set(KIROX_CURL_ROOT "${kirox_curl_SOURCE_DIR}")
endif()
add_library(KiroX::Curl SHARED IMPORTED GLOBAL)
set_target_properties(KiroX::Curl PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "${KIROX_CURL_ROOT}/include")
if(WIN32)
  set_target_properties(KiroX::Curl PROPERTIES
    IMPORTED_LOCATION "${KIROX_CURL_ROOT}/lib/libcurl-impersonate.dll"
    IMPORTED_IMPLIB "${KIROX_CURL_ROOT}/lib/libcurl-impersonate_imp.lib")
else()
  find_library(kirox_curl_library NAMES curl-impersonate curl-impersonate-chrome
    PATHS "${KIROX_CURL_ROOT}/lib" "${KIROX_CURL_ROOT}" NO_DEFAULT_PATH REQUIRED)
  set_target_properties(KiroX::Curl PROPERTIES IMPORTED_LOCATION "${kirox_curl_library}")
endif()
file(GLOB kirox_curl_licenses "${KIROX_CURL_ROOT}/LICENSE*")
install(FILES ${kirox_curl_licenses} DESTINATION licenses/curl-impersonate)
