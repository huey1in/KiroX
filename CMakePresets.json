{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {"name": "dev", "displayName": "Development", "generator": "Ninja", "binaryDir": "${sourceDir}/out/dev", "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "BUILD_TESTING": "ON"}},
    {"name": "release", "displayName": "Release", "generator": "Ninja", "binaryDir": "${sourceDir}/out/release", "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}}
  ],
  "buildPresets": [{"name": "dev", "configurePreset": "dev"}, {"name": "release", "configurePreset": "release"}],
  "testPresets": [{"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}}, {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}]
}
